# LLM provider: openrouter | anthropic | openai | fake. Leave empty to auto-detect:
# openrouter when OPENROUTER_API_KEY is set, else anthropic/openai when their key is set, else fake.
LLM_PROVIDER=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional OpenRouter attribution headers (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=briefing-agent
# Generator model (planning/compose/repair). OpenRouter slug; must exist in pricing.json.
LLM_MODEL=anthropic/claude-sonnet-4.5
# Cheap model for the think step.
CHEAP_MODEL=anthropic/claude-haiku-4.5
# Judge model. Must be a different family than LLM_MODEL when both are real.
JUDGE_MODEL=openai/gpt-4.1-mini

# Network: fixture (offline, replays tests/fixtures) | live | auto (fixture when provider is fake).
NETWORK_MODE=auto
HTTP_TIMEOUT_S=10

# Fault injection for evals/demos, e.g. "fetch_timeout:0.3,search_empty:0.2". Empty disables.
FAULTS=
FAULT_SEED=7

# Loop bounds (per run)
MAX_ITERATIONS=12
MAX_TOOL_CALLS=16
MAX_COST_USD_PER_RUN=0.25
RETRY_BUDGET_SEARCH=2
RETRY_BUDGET_FETCH=2
RETRY_BASE_MS=200
VERIFY_MATCH_THRESHOLD=0.6
MIN_FACTS=5
MAX_FACTS=8

# Storage
DB_PATH=data/briefing.db
TRACE_PATH=traces/spans.jsonl
CHECKPOINT_DIR=checkpoints
PRICING_PATH=pricing.json
FIXTURE_DIR=tests/fixtures/wikipedia

# API protection
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5
DAILY_USD_CAP=2.0
