# LLM provider: fake | anthropic | openai. Defaults to fake when no key is present.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Generator model (planning/compose/repair). Must exist in pricing.json for cost accounting.
LLM_MODEL=claude-sonnet-4-5
# Cheap model for the think step.
CHEAP_MODEL=claude-haiku-4-5
# Judge model. Use a different family than LLM_MODEL when both are real.
JUDGE_MODEL=gpt-4o-mini

# Network: fixture (offline, replays tests/fixtures) | live | auto (fixture when provider is fake).
NETWORK_MODE=auto
HTTP_TIMEOUT_S=10

# Fault injection for evals/demos, e.g. "fetch_timeout:0.3,search_empty:0.2". Empty disables.
FAULTS=
FAULT_SEED=7

# Loop bounds
MAX_ITERATIONS=12
MAX_TOOL_CALLS=16
MAX_COST_USD_PER_RUN=0.25
RETRY_BUDGET_SEARCH=2
RETRY_BUDGET_FETCH=2
RETRY_BASE_MS=200
VERIFY_MATCH_THRESHOLD=0.6
MIN_FACTS=5
MAX_FACTS=8

# Storage
DB_PATH=data/briefing.db
TRACE_PATH=traces/spans.jsonl
CHECKPOINT_DIR=checkpoints
PRICING_PATH=pricing.json

# API protection
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5
DAILY_USD_CAP=2.0
